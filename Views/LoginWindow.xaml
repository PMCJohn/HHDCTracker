<Window x:Class="HHDCTracker.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HHDC Tracker — Sign In"
        Width="420" Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/app.ico"
        Background="#F2F3F4">
    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="44">
            <!-- Logo + Title -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                <Image Source="/app_256.png" Width="48" Height="48"
                       Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HHDC Tracker" FontSize="22"
                               FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="{StaticResource TealDarkBrush}"/>
                    <TextBlock Text="Voucher Management System" FontSize="11"
                               Foreground="#888" FontFamily="Segoe UI"/>
                </StackPanel>
            </StackPanel>

            <!-- User -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Sign in as"/>
            <ComboBox x:Name="UserCombo" DisplayMemberPath="DisplayName"
                      Height="36" FontFamily="Segoe UI" FontSize="13"
                      Margin="0,0,0,12"
                      SelectionChanged="UserCombo_SelectionChanged"/>

            <!-- Location -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Location"/>
            <ComboBox x:Name="LocationCombo" DisplayMemberPath="Name"
                      Height="36" FontFamily="Segoe UI" FontSize="13"
                      Margin="0,0,0,20"/>

            <Button Content="Sign In" Style="{StaticResource PrimaryButton}"
                    Height="42" Click="SignIn_Click"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedAlertBrush}"
                       FontSize="12" Margin="0,8,0,0"
                       HorizontalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
