<UserControl x:Class="HHDCTracker.Views.Children.VoucherRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="EditBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#2E86C1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border x:Name="RootBorder" Background="White"
            BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
            Margin="0,0,0,0">
        <StackPanel>
            <!-- ── SUMMARY ROW (always visible) ── -->
            <Border Padding="16,12" Cursor="Hand"
                    MouseLeftButtonUp="Header_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Voucher #"/>
                        <TextBlock x:Name="LblVoucherNum" Style="{StaticResource FieldValue}"
                                   FontWeight="SemiBold" Foreground="#1A5276"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Type"/>
                        <TextBlock x:Name="LblRateType" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Period"/>
                        <TextBlock x:Name="LblPeriod" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="VO/Wk"/>
                        <TextBlock x:Name="LblVO" Style="{StaticResource FieldValue}"
                                   Foreground="#2471A3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="HHDC/Wk"/>
                        <TextBlock x:Name="LblHHDC" Style="{StaticResource FieldValue}"
                                   Foreground="#2471A3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Copay/Wk"/>
                        <TextBlock x:Name="LblCopay" Style="{StaticResource FieldValue}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Summer Window"/>
                        <TextBlock x:Name="LblSummer" Style="{StaticResource FieldValue}"
                                   Foreground="#888" FontSize="11"/>
                    </StackPanel>

                    <!-- Status badge + expand arrow -->
                    <StackPanel Grid.Column="7" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="StatusBadge" CornerRadius="10" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock x:Name="LblStatus" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock x:Name="ExpandArrow" Text="▶" Foreground="#888"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── EXPANDED DETAIL PANEL ── -->
            <Border x:Name="DetailPanel" Visibility="Collapsed"
                    Background="#F8FBFF" BorderBrush="#D6EAF8"
                    BorderThickness="0,1,0,0" Padding="16,14">
                <StackPanel>
                    <!-- Edit / Save / Cancel -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button x:Name="BtnEdit" Content="✏ Edit"
                                Style="{StaticResource EditButton}"
                                Padding="12,6" FontSize="12" Click="Edit_Click"/>
                        <Button x:Name="BtnSave" Content="💾 Save"
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,6" FontSize="12" Margin="8,0,0,0"
                                Visibility="Collapsed" Click="Save_Click"/>
                        <Button x:Name="BtnCancel" Content="Cancel"
                                Padding="12,6" FontSize="12" Margin="8,0,0,0"
                                Visibility="Collapsed" Click="Cancel_Click"/>
                    </StackPanel>

                    <!-- Standard rate fields -->
                    <TextBlock Text="STANDARD RATE" FontSize="10" FontWeight="Bold"
                               Foreground="#888" FontFamily="Segoe UI" Margin="0,0,0,8"
                              />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Voucher number -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Voucher Number"/>
                            <TextBlock x:Name="DLblVoucherNum" Style="{StaticResource FieldValue}"/>
                            <TextBox x:Name="DTxtVoucherNum" Style="{StaticResource EditBox}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- Rate type -->
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Rate Type"/>
                            <TextBlock x:Name="DLblRateType" Style="{StaticResource FieldValue}"/>
                            <ComboBox x:Name="DCboRateType" Visibility="Collapsed"
                                      FontFamily="Segoe UI" FontSize="13">
                                <ComboBoxItem Content="Normal Rate"/>
                                <ComboBoxItem Content="School-Year Rate"/>
                                <ComboBoxItem Content="Summer Rate"/>
                            </ComboBox>
                        </StackPanel>
                        <!-- Period start -->
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Period Start"/>
                            <TextBlock x:Name="DLblStart" Style="{StaticResource FieldValue}"/>
                            <TextBox x:Name="DTxtStart" Style="{StaticResource EditBox}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- Period end -->
                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Period End"/>
                            <TextBlock x:Name="DLblEnd" Style="{StaticResource FieldValue}"/>
                            <TextBox x:Name="DTxtEnd" Style="{StaticResource EditBox}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- Termination date -->
                        <StackPanel Grid.Column="4" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Termination Date"/>
                            <TextBlock x:Name="DLblTerm" Style="{StaticResource FieldValue}"/>
                            <TextBox x:Name="DTxtTerm" Style="{StaticResource EditBox}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- VO weekly -->
                        <StackPanel Grid.Column="5" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="VO Promised/Wk ($)"/>
                            <TextBlock x:Name="DLblVO" Style="{StaticResource FieldValue}"/>
                            <TextBox x:Name="DTxtVO" Style="{StaticResource EditBox}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- HHDC weekly -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="HHDC Charge/Wk ($)"/>
                            <TextBlock x:Name="DLblHHDC" Style="{StaticResource FieldValue}"/>
                            <TextBox x:Name="DTxtHHDC" Style="{StaticResource EditBox}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Summer rate fields -->
                    <TextBlock Text="SUMMER RATE WINDOW (optional)" FontSize="10"
                               FontWeight="Bold" Foreground="#888" FontFamily="Segoe UI"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Summer Start"/>
                            <TextBlock x:Name="DLblSumStart" Style="{StaticResource FieldValue}"/>
                            <TextBox x:Name="DTxtSumStart" Style="{StaticResource EditBox}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Summer End"/>
                            <TextBlock x:Name="DLblSumEnd" Style="{StaticResource FieldValue}"/>
                            <TextBox x:Name="DTxtSumEnd" Style="{StaticResource EditBox}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="VO Summer/Wk ($)"/>
                            <TextBlock x:Name="DLblSumVO" Style="{StaticResource FieldValue}"/>
                            <TextBox x:Name="DTxtSumVO" Style="{StaticResource EditBox}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="HHDC Summer/Wk ($)"/>
                            <TextBlock x:Name="DLblSumHHDC" Style="{StaticResource FieldValue}"/>
                            <TextBox x:Name="DTxtSumHHDC" Style="{StaticResource EditBox}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="PCA Code Label"/>
                            <TextBlock x:Name="DLblPCA" Style="{StaticResource FieldValue}"/>
                            <TextBox x:Name="DTxtPCA" Style="{StaticResource EditBox}"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
