<UserControl x:Class="HHDCTracker.Views.Dashboard.UnresolvedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource AccentOrangeBrush}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Unresolved Entries" Foreground="White"
                           FontSize="18" FontWeight="Bold" FontFamily="Segoe UI"/>
                <TextBlock Text="Imported rows that couldn't be matched. Resolve each entry to link it to the correct record."
                           Foreground="#FDEBD0" FontSize="12" FontFamily="Segoe UI"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border x:Name="NotificationBanner" DockPanel.Dock="Top"
                Padding="16,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NotificationText" Grid.Column="0"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Background="Transparent"
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        Padding="8,0" VerticalAlignment="Center"
                        Click="CloseNotification_Click"/>
            </Grid>
        </Border>

        <TabControl Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="16,8"/>
                </Style>
            </TabControl.Resources>

            <!-- Unresolved Invoices -->
            <TabItem Header="Unresolved Invoices">
                <DockPanel Margin="16,12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="🔄 Refresh" Style="{StaticResource PrimaryButton}"
                                Padding="12,6" FontSize="12" Click="RefreshInvoices_Click"/>
                        <TextBlock x:Name="InvoiceCountText" Margin="12,0,0,0"
                                   VerticalAlignment="Center" FontFamily="Segoe UI"
                                   FontSize="12" Foreground="#888"/>
                    </StackPanel>
                    <TextBlock x:Name="InvoiceLastRefresh" DockPanel.Dock="Top"
                               FontSize="10" Foreground="#AAA" FontFamily="Segoe UI"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="InvoiceGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" Background="White"
                              RowBackground="White" AlternatingRowBackground="#FEF9E7"
                              BorderThickness="1" BorderBrush="#E0E0E0"
                              FontFamily="Segoe UI" FontSize="12" SelectionMode="Single"
                              SelectionChanged="InvoiceGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFlags}" Value="True">
                                        <Setter Property="Background" Value="#FEF9E7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Raw Voucher #"
                                               Binding="{Binding RawVoucherNumber}" Width="120"/>
                            <DataGridTextColumn Header="Child Name (MSDE)"
                                               Binding="{Binding RawChildName}" Width="160"/>
                            <DataGridTextColumn Header="Invoice #"
                                               Binding="{Binding InvoiceNumber}" Width="100"/>
                            <DataGridTextColumn Header="Start"
                                               Binding="{Binding InvoiceStart, StringFormat='MM/dd/yyyy'}" Width="90"/>
                            <DataGridTextColumn Header="End"
                                               Binding="{Binding InvoiceEnd, StringFormat='MM/dd/yyyy'}" Width="90"/>
                            <DataGridTextColumn Header="Payment"
                                               Binding="{Binding PaymentTotal, StringFormat='${0:N2}'}" Width="90"/>
                            <DataGridTextColumn Header="⚠ Flags"
                                               Binding="{Binding FlagText}" Width="*"/>
                            <DataGridTemplateColumn Header="Actions" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Resolve"
                                                    Style="{StaticResource EditButton}"
                                                    Padding="8,3" FontSize="11"
                                                    Tag="{Binding InvoiceId}"
                                                    Click="ResolveInvoice_Click"
                                                    Margin="4,2,2,2"/>
                                            <Button Content="Delete"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="8,3" FontSize="11"
                                                    Tag="{Binding InvoiceId}"
                                                    Click="DeleteInvoice_Click"
                                                    Margin="2,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Unresolved True-Ups -->
            <TabItem Header="Unresolved True-Ups">
                <DockPanel Margin="16,12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="🔄 Refresh" Style="{StaticResource PrimaryButton}"
                                Padding="12,6" FontSize="12" Click="RefreshTrueUps_Click"/>
                        <TextBlock x:Name="TrueUpCountText" Margin="12,0,0,0"
                                   VerticalAlignment="Center" FontFamily="Segoe UI"
                                   FontSize="12" Foreground="#888"/>
                    </StackPanel>
                    <TextBlock x:Name="TrueUpLastRefresh" DockPanel.Dock="Top"
                               FontSize="10" Foreground="#AAA" FontFamily="Segoe UI"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="TrueUpGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" Background="White"
                              RowBackground="White" AlternatingRowBackground="#F4ECF7"
                              BorderThickness="1" BorderBrush="#E0E0E0"
                              FontFamily="Segoe UI" FontSize="12" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Raw Voucher #"
                                               Binding="{Binding RawVoucherNumber}" Width="120"/>
                            <DataGridTextColumn Header="Child Name (MSDE)"
                                               Binding="{Binding RawChildName}" Width="160"/>
                            <DataGridTextColumn Header="Type"
                                               Binding="{Binding TrueUpType}" Width="200"/>
                            <DataGridTextColumn Header="Reason"
                                               Binding="{Binding Reason}" Width="140"/>
                            <DataGridTextColumn Header="AP Month"
                                               Binding="{Binding APReconcilingMonth}" Width="90"/>
                            <DataGridTextColumn Header="Amount"
                                               Binding="{Binding TrueUpAdjustAmount, StringFormat='${0:N2}'}" Width="90"/>
                            <DataGridTextColumn Header="Imported"
                                               Binding="{Binding ImportedAt, StringFormat='MM/dd/yyyy'}" Width="90"/>
                            <DataGridTemplateColumn Header="Actions" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Resolve"
                                                    Style="{StaticResource EditButton}"
                                                    Padding="8,3" FontSize="11"
                                                    Tag="{Binding UnresolvedTrueUpId}"
                                                    Click="ResolveTrueUp_Click"
                                                    Margin="4,2,2,2"/>
                                            <Button Content="Delete"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="8,3" FontSize="11"
                                                    Tag="{Binding UnresolvedTrueUpId}"
                                                    Click="DeleteTrueUp_Click"
                                                    Margin="2,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
