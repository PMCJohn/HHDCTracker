<Window x:Class="HHDCTracker.Views.Dashboard.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit User" Width="460" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/app.ico" Background="#F2F3F4">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                   FontFamily="Segoe UI" Foreground="#1A5276" Margin="0,0,0,20"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Display Name"/>
                <TextBox x:Name="TxtName" Padding="8,6" FontFamily="Segoe UI"
                         FontSize="13" BorderBrush="#2E86C1" BorderThickness="1"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Role"/>
                <ComboBox x:Name="CboRole" FontFamily="Segoe UI" FontSize="13" Height="34">
                    <ComboBoxItem Content="Staff"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Location assignment -->
        <TextBlock Style="{StaticResource FieldLabel}" Text="Assigned Locations"/>
        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                Padding="8" Margin="0,0,0,12" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LocationChecks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsAssigned, Mode=TwoWay}"
                                      FontFamily="Segoe UI" FontSize="12"
                                      Margin="0,3,0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status toggles -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <CheckBox x:Name="ChkActive" Content="Active (can log in)"
                      FontFamily="Segoe UI" FontSize="12" Margin="0,0,16,0"/>
            <CheckBox x:Name="ChkArchived" Content="Archived (hidden from lists)"
                      FontFamily="Segoe UI" FontSize="12"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Delete User" Style="{StaticResource DangerButton}"
                    Padding="14,8" Margin="0,0,8,0" Click="Delete_Click"/>
            <Button Content="Cancel" Padding="14,8" Margin="0,0,8,0"
                    FontFamily="Segoe UI" FontSize="13" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}"
                    Padding="14,8" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
