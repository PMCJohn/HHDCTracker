<UserControl x:Class="HHDCTracker.Views.Dashboard.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="780">

            <!-- ── DATABASE PATH ──────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}"
                               Text="Database Location"/>
                    <TextBlock Text="Points all workstations to the shared database file. Each computer needs an hhdc.config file next to the .exe containing the network path."
                               FontSize="12" Foreground="#888" FontFamily="Segoe UI"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Current Path"/>
                    <Border Background="#F8F9FA" BorderBrush="#E0E0E0"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,8" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtCurrentPath" FontFamily="Consolas"
                                   FontSize="12" TextWrapping="Wrap" Foreground="#333"/>
                    </Border>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="New Path"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNewPath" Grid.Column="0"
                                 Padding="8,6" FontFamily="Segoe UI" FontSize="13"
                                 BorderBrush="#2E86C1" BorderThickness="1"/>
                        <Button Grid.Column="2" Content="Browse..."
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,6" FontSize="12" Click="Browse_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Apply &amp; Restart"
                                Style="{StaticResource PrimaryButton}"
                                Padding="16,8" Click="ApplyPath_Click"/>
                        <TextBlock x:Name="PathStatus" Margin="12,0,0,0"
                                   VerticalAlignment="Center" FontFamily="Segoe UI"
                                   FontSize="12" Foreground="#27AE60"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── USERS ──────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Users"/>
                    <!-- Show archived toggle -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                HorizontalAlignment="Right">
                        <ToggleButton x:Name="ShowArchivedUsersToggle"
                                      Content="Show Archived"
                                      FontFamily="Segoe UI" FontSize="11"
                                      Padding="8,3"
                                      Checked="ArchivedUsersToggle_Changed"
                                      Unchecked="ArchivedUsersToggle_Changed"/>
                    </StackPanel>
                    <ItemsControl x:Name="UserItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                        Padding="0,4">
                                    <!-- Collapsed summary row -->
                                    <StackPanel>
                                        <Grid x:Name="SummaryRow" Cursor="Hand"
                                              MouseLeftButtonUp="UserRow_Click">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Segoe UI" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    CornerRadius="10" Padding="6,2"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#D5F5E3"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#FADBD8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Role}"
                                                           FontSize="11" FontFamily="Segoe UI"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="▶"
                                                       Foreground="#888" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <!-- Expanded detail — shown via code-behind tag -->
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add user -->
                    <Border Background="#F8F9FA" CornerRadius="4"
                            Padding="12,10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ADD USER" FontSize="10" FontWeight="Bold"
                                       Foreground="#888" FontFamily="Segoe UI"
                                       Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Display Name"/>
                                    <TextBox x:Name="TxtNewUserName" Padding="8,6"
                                             FontFamily="Segoe UI" FontSize="13"
                                             BorderBrush="#2E86C1" BorderThickness="1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Role"/>
                                    <ComboBox x:Name="CboNewUserRole"
                                              FontFamily="Segoe UI" FontSize="13" Height="34">
                                        <ComboBoxItem Content="Staff" IsSelected="True"/>
                                        <ComboBoxItem Content="Admin"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Button Content="Add User" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Padding="14,6"
                                    FontSize="12" Click="AddUser_Click"/>
                            <TextBlock x:Name="UserStatus" FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#27AE60" Margin="0,6,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── LOCATIONS ──────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Locations"/>
                    <ItemsControl x:Name="LocationItemsControl" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                        Padding="4,8" Cursor="Hand"
                                        MouseLeftButtonUp="LocationRow_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="20"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontWeight="SemiBold" FontFamily="Segoe UI"
                                                   FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Address}"
                                                   Foreground="#888" FontFamily="Segoe UI"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" FontFamily="Segoe UI"
                                                   FontSize="11" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Active"/>
                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Inactive"/>
                                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="▶" Foreground="#888"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="#F8F9FA" CornerRadius="4" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="ADD LOCATION" FontSize="10" FontWeight="Bold"
                                       Foreground="#888" FontFamily="Segoe UI"
                                       Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Location Name"/>
                                    <TextBox x:Name="TxtNewLocName" Padding="8,6"
                                             FontFamily="Segoe UI" FontSize="13"
                                             BorderBrush="#2E86C1" BorderThickness="1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Address (optional)"/>
                                    <TextBox x:Name="TxtNewLocAddress" Padding="8,6"
                                             FontFamily="Segoe UI" FontSize="13"
                                             BorderBrush="#2E86C1" BorderThickness="1"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="Add Location"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Padding="14,6"
                                    FontSize="12" Click="AddLocation_Click"/>
                            <TextBlock x:Name="LocStatus" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="#27AE60"
                                       Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── APP INFO ───────────────────────────────── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="About"/>
                    <TextBlock Text="HHDC Voucher Tracker" FontWeight="SemiBold"
                               FontFamily="Segoe UI" FontSize="13"/>
                    <TextBlock x:Name="TxtDbInfo" FontSize="11" Foreground="#888"
                               FontFamily="Segoe UI" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
