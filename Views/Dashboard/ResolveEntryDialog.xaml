<Window x:Class="HHDCTracker.Views.Dashboard.ResolveEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolve Entry" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/app.ico" Background="#F2F3F4">
    <StackPanel Margin="24">
        <!-- Header -->
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                   FontFamily="Segoe UI" Foreground="#1A5276" Margin="0,0,0,8"/>

        <!-- Raw MSDE info -->
        <Border Background="#FEF9E7" BorderBrush="#F39C12" BorderThickness="1"
                CornerRadius="4" Padding="12,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="MSDE DATA" FontSize="10" FontWeight="Bold"
                           Foreground="#888" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="Child Name (MSDE)"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LblRawName"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="Voucher #" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LblRawVoucher"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                               Margin="0,6,0,0" Foreground="{StaticResource TealDarkBrush}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="Entry Details" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LblEntryDetails"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#666"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Child search -->
        <TextBlock Style="{StaticResource FieldLabel}" Text="Search for Child to Link To"/>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSearch" Grid.Column="0" Padding="8,6"
                     FontFamily="Segoe UI" FontSize="13"
                     BorderBrush="#2E86C1" BorderThickness="1"/>
            <Button Grid.Column="2" Content="Search"
                    Style="{StaticResource PrimaryButton}"
                    Padding="12,6" FontSize="12" Click="Search_Click"/>
        </Grid>

        <!-- Search results -->
        <ListBox x:Name="ResultsList" MaxHeight="160" Margin="0,0,0,12"
                 BorderBrush="#E0E0E0" BorderThickness="1"
                 FontFamily="Segoe UI" FontSize="13"
                 SelectionChanged="ResultsList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,4">
                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ActiveVoucherSummary}"
                                   FontSize="11" Foreground="#888"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Selected child + voucher -->
        <Border x:Name="SelectionPanel" Background="{StaticResource TealLightBrush}"
                CornerRadius="4" Padding="12,10" Margin="0,0,0,16"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="LINKING TO" FontSize="10" FontWeight="Bold"
                           Foreground="#888" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                <TextBlock x:Name="LblSelectedChild" FontFamily="Segoe UI"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TealDarkBrush}"/>
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="Select Voucher" Margin="0,8,0,4"/>
                <ComboBox x:Name="VoucherCombo" DisplayMemberPath="VoucherDisplay"
                          FontFamily="Segoe UI" FontSize="13" Height="34"
                          SelectionChanged="VoucherCombo_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="14,8" FontFamily="Segoe UI"
                    FontSize="13" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="BtnResolve" Content="Resolve &amp; Link"
                    Style="{StaticResource PrimaryButton}"
                    Padding="14,8" IsEnabled="False" Click="Resolve_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
