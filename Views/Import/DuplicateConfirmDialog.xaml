<Window x:Class="HHDCTracker.Views.Import.DuplicateConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicates Detected" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/app.ico" Background="#F2F3F4">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                   FontFamily="Segoe UI" Foreground="#E67E22" Margin="0,0,0,8"/>
        <TextBlock x:Name="SubText" FontSize="12" Foreground="#666"
                   FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Border Background="#FEF9E7" BorderBrush="#F39C12"
                BorderThickness="1" CornerRadius="4"
                Padding="12,10" Margin="0,0,0,20" MaxHeight="200">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DupeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Segoe UI"
                                       FontSize="12" Margin="0,2,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel Import" Padding="14,8"
                    FontFamily="Segoe UI" FontSize="13"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Proceed Anyway"
                    Style="{StaticResource EditButton}"
                    Padding="14,8" Click="Proceed_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
