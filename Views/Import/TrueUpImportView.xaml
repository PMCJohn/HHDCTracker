<UserControl x:Class="HHDCTracker.Views.Import.TrueUpImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4">
    <DockPanel>

        <!-- ── HEADER ─────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PurpleDarkBrush}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Import MSDE True-Ups" Foreground="White"
                           FontSize="18" FontWeight="Bold" FontFamily="Segoe UI"/>
                <TextBlock Text="Select the true-up type, optionally enter an invoice reference, paste your MSDE data, then click Import."
                           Foreground="#D7BDE2" FontSize="12" FontFamily="Segoe UI"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── NOTIFICATION BANNER ────────────────────────────── -->
        <Border x:Name="NotificationBanner" DockPanel.Dock="Top"
                Padding="16,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NotificationText" Grid.Column="0"
                           FontFamily="Segoe UI" FontSize="13"
                           FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕"
                        Background="Transparent" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Padding="8,0"
                        VerticalAlignment="Center"
                        Click="CloseNotification_Click"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16">

                <!-- ── TRUE-UP SUB-TABLE ──────────────────────── -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Text="True-Up Information"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="Invoice # (optional — leave blank for New Voucher type)"/>
                                <TextBox x:Name="TxtInvoiceNum" Padding="8,6"
                                         FontFamily="Segoe UI" FontSize="13"
                                         BorderBrush="#8E44AD" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="True-Up Type"/>
                                <ComboBox x:Name="CboTrueUpType"
                                          FontFamily="Segoe UI" FontSize="13" Height="34"
                                          BorderBrush="#8E44AD">
                                    <ComboBoxItem Content="Additional Amounts Reconciliation"
                                                  IsSelected="True"/>
                                    <ComboBoxItem Content="Adjustment Amounts Reconciliation"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── PASTE AREA ─────────────────────────────── -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="MSDE True-Up Data" Margin="0"/>
                            <TextBlock Text="  — paste directly from MSDE portal below"
                                       FontSize="12" Foreground="#888"
                                       FontFamily="Segoe UI" VerticalAlignment="Bottom"
                                       Margin="0,0,0,8"/>
                        </StackPanel>

                        <!-- Column headers reference -->
                        <Border DockPanel.Dock="Top" Background="{StaticResource PurpleLightBrush}"
                                CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#6C3483"
                                       Text="Reason | Scholarship Number | Child Name | 1st AP Invoice # | 2nd AP Invoice # | AP Reconciling Month | AP Amount | # Adjust Days | True Up Adjust Amount"/>
                        </Border>

                        <TextBox x:Name="PasteBox"
                                 DockPanel.Dock="Top"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Consolas" FontSize="12"
                                 Height="280" Padding="8"
                                 BorderBrush="#CCCCCC" BorderThickness="1"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </DockPanel>
                </Border>

                <!-- ── IMPORT BUTTON ──────────────────────────── -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="▶  Import True-Ups"
                            Style="{StaticResource PurpleButton}"
                            Padding="20,10" FontSize="14"
                            Click="Import_Click"/>
                    <Button Content="Clear" Padding="14,10" FontSize="13"
                            Margin="12,0,0,0" FontFamily="Segoe UI"
                            Click="Clear_Click"/>
                    <TextBlock x:Name="StatusText" Margin="16,0,0,0"
                               VerticalAlignment="Center" FontFamily="Segoe UI"
                               FontSize="12" Foreground="#888"
                               Visibility="Collapsed"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
