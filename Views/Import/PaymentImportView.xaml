<UserControl x:Class="HHDCTracker.Views.Import.PaymentImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource TealDarkBrush}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Import MSDE Payments" Foreground="White"
                           FontSize="18" FontWeight="Bold" FontFamily="Segoe UI"/>
                <TextBlock Text="Fill in the invoice details, paste your MSDE data, then click Import."
                           Foreground="#A9CCE3" FontSize="12" FontFamily="Segoe UI"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border x:Name="NotificationBanner" DockPanel.Dock="Top"
                Padding="16,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NotificationText" Grid.Column="0"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Background="Transparent"
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        Padding="8,0" VerticalAlignment="Center"
                        Click="CloseNotification_Click"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16">
                <!-- Invoice sub-table -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Text="Invoice Information"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Invoice #"/>
                                <TextBox x:Name="TxtInvoiceNum" Padding="8,6"
                                         FontFamily="Segoe UI" FontSize="13"
                                         BorderBrush="#2E86C1" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Start Date"/>
                                <TextBox x:Name="TxtStartDate" Padding="8,6"
                                         FontFamily="Segoe UI" FontSize="13"
                                         BorderBrush="#2E86C1" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="End Date"/>
                                <TextBox x:Name="TxtEndDate" Padding="8,6"
                                         FontFamily="Segoe UI" FontSize="13"
                                         BorderBrush="#2E86C1" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Payment Date"/>
                                <TextBox x:Name="TxtPayDate" Padding="8,6"
                                         FontFamily="Segoe UI" FontSize="13"
                                         BorderBrush="#2E86C1" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Paste area -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="MSDE Payment Data" Margin="0"/>
                            <TextBlock Text="  — paste directly from MSDE portal"
                                       FontSize="12" Foreground="#888" FontFamily="Segoe UI"
                                       VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource TealLightBrush}"
                                CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#1A5276"
                                       Text="Child Name | Infant | DOB | Reg Fee | Absences | Care Units | Special Need | MD EXCELS | Scholarship | Payment Total | PCA Code | True-Up (Y/N) | Scholarship ID"/>
                        </Border>
                        <TextBox x:Name="PasteBox" DockPanel.Dock="Top"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Consolas" FontSize="12" Height="280" Padding="8"
                                 BorderBrush="#CCCCCC" BorderThickness="1"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </DockPanel>
                </Border>

                <!-- Import button + progress -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnImport" Content="▶  Import Payments"
                                Style="{StaticResource PrimaryButton}"
                                Padding="20,10" FontSize="14" Click="Import_Click"/>
                        <Button Content="Clear" Padding="14,10" FontSize="13"
                                Margin="12,0,0,0" FontFamily="Segoe UI" Click="Clear_Click"/>
                    </StackPanel>
                    <Border x:Name="ProgressPanel" Visibility="Collapsed"
                            Background="White" CornerRadius="4"
                            BorderBrush="#E0E0E0" BorderThickness="1"
                            Padding="12,10" MaxWidth="420" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="ProgressLabel" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                            <Grid>
                                <ProgressBar x:Name="ImportProgressBar" Height="18"
                                             Minimum="0" Maximum="100"
                                             Foreground="{StaticResource TealMidBrush}"
                                             Background="#EEE" BorderThickness="0"/>
                                <TextBlock x:Name="ProgressPct"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="White" FontFamily="Segoe UI"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
