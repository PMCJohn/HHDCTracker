<Window x:Class="HHDCTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HHDC Voucher Tracker"
        Width="1280" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/app.ico" Background="#F2F3F4">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D6EAF8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E86C1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#2E86C1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition x:Name="ChildPaneCol" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT NAV ══════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource TealDarkBrush}">
            <DockPanel>
                <!-- App title -->
                <Border DockPanel.Dock="Top" Padding="16,16,16,12">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/app_256.png" Width="32" Height="32"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HHDC Tracker" Foreground="White"
                                       FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="CurrentUserText" Foreground="#A9CCE3"
                                       FontSize="11" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Location -->
                <Border DockPanel.Dock="Top" Background="#154360" Padding="16,6">
                    <TextBlock x:Name="LocationText" Foreground="#85C1E9"
                               FontSize="11" FontFamily="Segoe UI"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- Progress bar — shown during long operations -->
                <Border DockPanel.Dock="Bottom" x:Name="ProgressArea"
                        Background="#154360" Padding="12,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ProgressLabel" Foreground="#A9CCE3"
                                   FontSize="10" FontFamily="Segoe UI"
                                   Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <Grid>
                            <ProgressBar x:Name="NavProgressBar" Height="16"
                                         Minimum="0" Maximum="100"
                                         Background="#1A5276"
                                         Foreground="{StaticResource TealMidBrush}"
                                         BorderThickness="0"/>
                            <TextBlock x:Name="ProgressPct"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Logout -->
                <Border DockPanel.Dock="Bottom" BorderBrush="#2E86C1"
                        BorderThickness="0,1,0,0" Height="42">
                    <Button Content="🔄  Switch / Log Out"
                            Style="{StaticResource NavButton}"
                            FontSize="11" Padding="16,10"
                            VerticalAlignment="Center"
                            Click="Logout_Click"/>
                </Border>

                <!-- Nav items -->
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <Button x:Name="NavDashboard" Content="📊  Dashboard"
                            Style="{StaticResource NavButtonActive}"
                            Click="Nav_Click" Tag="Dashboard"/>
                    <Button x:Name="NavChildren" Content="👶  Children"
                            Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="Children"/>
                    <Button x:Name="NavProblems" Content="⚠️  Problem Report"
                            Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="Problems"/>
                    <Button x:Name="NavUnresolved" Content="🔗  Unresolved"
                            Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="Unresolved"/>
                    <Button x:Name="NavImport" Content="📥  Import Payments"
                            Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="Import"/>
                    <Button x:Name="NavTrueUp" Content="📋  Import True-Ups"
                            Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="TrueUp"/>
                    <Separator Background="#2E86C1" Margin="16,8"/>
                    <Button x:Name="NavSettings" Content="⚙️  Settings"
                            Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ CHILD LIST PANEL ═══════════════════════════════ -->
        <Border Grid.Column="1" x:Name="ChildPane"
                Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0" Visibility="Collapsed">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource TealDarkBrush}" Padding="10,10">
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Background="#2E86C1" Foreground="White"
                                 BorderThickness="0" FontFamily="Segoe UI" FontSize="13"
                                 Height="32" Padding="8,4" CaretBrush="White"
                                 TextChanged="Search_Changed">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="🔍  Search children or voucher #"
                                   Foreground="#A9CCE3" FontFamily="Segoe UI" FontSize="12"
                                   Margin="10,7,0,0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top" Padding="10,8" Background="#FAFAFA"
                        BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="+ Add Child"
                                Style="{StaticResource PrimaryButton}"
                                Height="30" FontSize="12" Padding="12,4"
                                Click="AddChild_Click"/>
                        <ToggleButton x:Name="ShowArchivedToggle" Grid.Column="1"
                                      Content="Archived" FontFamily="Segoe UI"
                                      FontSize="11" Padding="8,4" Margin="6,0,0,0"
                                      Checked="ArchiveToggle_Changed"
                                      Unchecked="ArchiveToggle_Changed"/>
                    </Grid>
                </Border>

                <ListBox x:Name="ChildList" BorderThickness="0"
                         SelectionChanged="ChildList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" BorderBrush="#F0F0F0"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   FontFamily="Segoe UI"/>
                                        <TextBlock Text="{Binding ActiveVoucherSummary}"
                                                   FontSize="11" Foreground="#888"
                                                   FontFamily="Segoe UI"/>
                                        <TextBlock Text="ARCHIVED" FontSize="10"
                                                   Foreground="#E74C3C" FontWeight="Bold"
                                                   FontFamily="Segoe UI"
                                                   Visibility="{Binding IsArchived,
                                                       Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource RedAlertBrush}"
                                            CornerRadius="10" Width="20" Height="20"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasUnresolved,
                                                Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="!" Foreground="White"
                                                   FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ DETAIL PANEL ═══════════════════════════════════ -->
        <Border Grid.Column="2" Background="#F2F3F4">
            <ContentPresenter x:Name="DetailPane"/>
        </Border>
    </Grid>
</Window>
